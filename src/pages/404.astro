---
import Layout from "@/layouts/Layout.astro";
import { getDictionary } from "@/utils/dictionary";
import { getLangFromPathname } from "@/utils/i18n";

const lang = getLangFromPathname(Astro.url.pathname);
const copy = getDictionary(lang).notFound;
const homeHref = `/${lang}/`;
const blogHref = `/${lang}/blog`;
---

<Layout title={copy.title} description={copy.description} lang={lang}>
  <main class="min-h-screen bg-stone-50 px-6 py-16 text-stone-900 dark:bg-stone-950 dark:text-stone-100 sm:px-10">
    <div class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center text-center">
      <div class="relative mb-8 select-none" aria-hidden="true">
        <span class="text-[clamp(7rem,25vw,13rem)] font-black leading-none tracking-[-0.08em] text-stone-200 dark:text-stone-800">
          404
        </span>
        <span class="absolute inset-0 flex items-center justify-center pt-5 text-5xl text-red-700/80 dark:text-red-400/80">
          ✦
        </span>
      </div>

      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.28em] text-red-700 dark:text-red-400">
        {copy.eyebrow}
      </p>
      <h1 class="max-w-xl text-3xl font-bold tracking-tight sm:text-4xl">
        {copy.heading}
      </h1>
      <p class="mt-4 max-w-lg text-base leading-7 text-stone-600 dark:text-stone-400">
        {copy.message}
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={homeHref}
          class="rounded-full bg-red-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-800 focus:outline-none focus:ring-2 focus:ring-red-700 focus:ring-offset-2 dark:bg-red-500 dark:hover:bg-red-400 dark:focus:ring-red-400 dark:focus:ring-offset-stone-950"
        >
          {copy.home}
        </a>
        <a
          href={blogHref}
          class="rounded-full border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 transition hover:border-red-700 hover:text-red-700 focus:outline-none focus:ring-2 focus:ring-red-700 focus:ring-offset-2 dark:border-stone-700 dark:text-stone-300 dark:hover:border-red-400 dark:hover:text-red-400 dark:focus:ring-red-400 dark:focus:ring-offset-stone-950"
        >
          {copy.blog}
        </a>
      </div>
    </div>
  </main>
</Layout>
